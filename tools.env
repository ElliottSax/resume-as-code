# Single source of truth for every tool version this repo uses.
# scripts/install-tools.sh reads this file on laptops AND in CI, so
# "works on my machine" and "works in the pipeline" are the same claim.
# Bump a version here, open a PR, and the whole pipeline re-proves it.

GO_VERSION=1.27.4
GO_SHA256=7226736c2339719cda28fbf3a54d71aa63bcefe376e98cef00034268dab24840

KIND_VERSION=0.33.0
KUBECTL_VERSION=1.37.2
HELM_VERSION=4.3.2
KUBECONFORM_VERSION=0.8.0
KYVERNO_VERSION=1.20.0
PROMETHEUS_VERSION=3.16.0
TERRAFORM_VERSION=1.17.2
TFLINT_VERSION=0.66.0
TRIVY_VERSION=0.76.2
ACTIONLINT_VERSION=1.7.12
GOLANGCI_LINT_VERSION=2.15.0

# The ShellCheck project publishes no checksum file, so its hash is pinned here.
SHELLCHECK_VERSION=0.11.0
SHELLCHECK_SHA256=b7af85e41cc99489dcc21d66c6d5f3685138f06d34651e6d34b42ec6d54fe6f6

# Images and charts the chaos drill pulls, pinned by digest or exact version.
KIND_NODE_IMAGE=kindest/node:v1.37.0@sha256:a1ed56cfb0e7b93589bdf97c8cd566405a265939e3620fc4f5de89adff580ae5
K6_IMAGE=grafana/k6:2.4.0@sha256:d41bb79cd8de5a7ad619b53570e3712633e8bff0937010a5c6c57a4747e7a276
METRICS_SERVER_CHART_VERSION=3.14.0
KUBE_PROMETHEUS_STACK_VERSION=93.9.0

# The throwaway registry scripts/release-dry-run.sh pushes to. ci.yml's
# service container pins the same digest; keep the two in step.
REGISTRY_IMAGE=registry:3@sha256:82f6ff4a7f982960c8aa51617fea3aabc485df6e55cce80d22deb1de36f1bc3c
